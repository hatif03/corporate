# GCP project this backend talks to
GOOGLE_CLOUD_PROJECT=project-f0b6b4ce-541f-43ff-9f7
GOOGLE_GENAI_USE_VERTEXAI=1
VERTEX_LOCATION=us-central1

# Gemini model used by every agent by default (flash tier; satisfies the hackathon's Gemini 3.5+ requirement, ADR-0020)
CORPORATE_GEMINI_MODEL=gemini-3.5-flash

# Higher-capability tier a task uses when the CEO sets model_tier="pro" (ADR-0013)
CORPORATE_GEMINI_MODEL_PRO=gemini-3.1-pro-preview

# Independent second-opinion model for hallucination checking (shared/cross_model_check.py, ADR-0019/0020)
CORPORATE_VERIFIER_MODEL=gemini-3.5-flash-lite

# Break-room ambient music generation (app/services/lyria_client.py, ADR-0019)
CORPORATE_LYRIA_MODEL=lyria-002

# Marketing promo-video generation (app/services/veo_client.py, ADR-0019)
CORPORATE_VEO_MODEL=veo-3.1-generate-001

# Org tenant this single-org demo deployment serves
CORPORATE_DEFAULT_ORG_ID=demo

# Pub/Sub topic for inter-agent messaging
CORPORATE_PUBSUB_TOPIC=agent-bus

# GCS bucket for vision attachments, no gs:// prefix (ADR-0013)
CORPORATE_ATTACHMENTS_BUCKET=

# Fallback circuit breaker on raw Gemini call volume/spend, per org per day —
# only used when an org hasn't set its own budget from the Settings tab
# (ADR-0012, ADR-0013)
CORPORATE_DAILY_GEMINI_CALL_LIMIT=5000

# Set to 1 to run the Pub/Sub pull-loop instead of expecting push delivery (local dev only)
LOCAL_DEV=0

# Public base URL of this backend, used to register Pub/Sub push subscriptions
CORPORATE_BACKEND_URL=https://corporate-backend-REPLACE.run.app

# Public URL of the standalone A2A server (app/a2a_server.py), once deployed
# as its own Cloud Run service (see ADR-0004 and README.md). Leave blank for
# local dev — the Agent Card will just advertise "http://localhost:8001".
CORPORATE_A2A_SALES_URL=

# OAuth "Connect with X" flow (ADR-0018) — one-time manual prerequisite:
# register an app in each provider's own console (api.slack.com/apps,
# github.com/settings/developers, notion.so/my-integrations) with redirect
# URL {CORPORATE_BACKEND_URL}/api/oauth/{kind}/callback, then set the
# resulting client ID here and store the client secret in Secret Manager as
# oauth-{kind}-client-secret. Leave blank to leave that provider's Connect
# button non-functional (it 500s with a clear "not configured" error).
SLACK_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_ID=

# Locally-generated signing key for the OAuth state param (not a third-party
# credential — any random string, e.g. `openssl rand -hex 32`)
OAUTH_STATE_SECRET=
